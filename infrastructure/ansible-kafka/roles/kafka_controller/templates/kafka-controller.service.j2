[Unit]
Description=Apache Kafka KRaft Controller
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=10

[Service]
Type=simple
User={{ kafka_user }}
Group={{ kafka_group }}
Environment="JAVA_HOME={{ java_home }}"
Environment="KAFKA_HEAP_OPTS={{ kafka_controller_heap_opts }}"
Environment="KAFKA_OPTS=-javaagent:{{ jmx_exporter_jar_path }}={{ kafka_controller_jmx_exporter_port }}:{{ kafka_controller_jmx_exporter_config_file }}"
Environment="LOG_DIR={{ kafka_controller_log_dir }}"
ExecStart={{ kafka_home }}/bin/kafka-server-start.sh {{ kafka_controller_config_file }}
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
SuccessExitStatus=143
TimeoutStopSec=300
LimitNOFILE=64000

[Install]
WantedBy=multi-user.target
