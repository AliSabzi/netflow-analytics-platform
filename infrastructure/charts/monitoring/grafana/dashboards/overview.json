{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "links": [{"title": "Alerting", "type": "link", "url": "/alerting/list", "icon": "bell"}],
  "panels": [
    {
      "type": "stat", "title": "Writer Last Commit Age", "gridPos": {"h": 5, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "time() - max by (topic) (netflow_hdfs_last_commit_timestamp_seconds{job=\"hdfs-writer\",topic=~\"$topic\"} > 0)", "legendFormat": "HDFS {{topic}}", "instant": true, "refId": "A"},
        {"expr": "time() - max by (topic) (netflow_starrocks_last_commit_timestamp_seconds{job=\"starrocks-writer\",topic=~\"$topic\"} > 0)", "legendFormat": "StarRocks {{topic}}", "instant": true, "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "noValue": "Unknown", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 300}, {"color": "red", "value": 900}]}, "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "type": "timeseries", "title": "Pipeline Rate", "gridPos": {"h": 8, "w": 16, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (topic) (rate(kafka_server_brokertopicmetrics_messagesin_total{job=\"kafka-broker\",topic=~\"$topic\"}[$__rate_interval]))", "legendFormat": "Kafka input {{topic}}", "refId": "A"},
        {"expr": "sum by (topic) (rate(netflow_hdfs_records_received_total{job=\"hdfs-writer\",topic=~\"$topic\"}[$__rate_interval]))", "legendFormat": "HDFS received {{topic}}", "refId": "B"},
        {"expr": "sum by (topic) (rate(netflow_hdfs_records_written_total{job=\"hdfs-writer\",topic=~\"$topic\"}[$__rate_interval]))", "legendFormat": "HDFS written {{topic}}", "refId": "C"},
        {"expr": "sum by (topic) (rate(netflow_hdfs_records_committed_total{job=\"hdfs-writer\",topic=~\"$topic\"}[$__rate_interval]))", "legendFormat": "HDFS committed {{topic}}", "refId": "D"},
        {"expr": "sum by (topic) (rate(netflow_hdfs_records_dlq_total{job=\"hdfs-writer\",topic=~\"$topic\"}[$__rate_interval]))", "legendFormat": "HDFS DLQ {{topic}}", "refId": "H"},
        {"expr": "sum by (topic) (rate(netflow_starrocks_records_received_total{job=\"starrocks-writer\",topic=~\"$topic\"}[$__rate_interval]))", "legendFormat": "StarRocks received {{topic}}", "refId": "E"},
        {"expr": "sum by (topic) (rate(netflow_starrocks_records_loaded_total{job=\"starrocks-writer\",topic=~\"$topic\"}[$__rate_interval]))", "legendFormat": "StarRocks loaded {{topic}}", "refId": "F"},
        {"expr": "sum by (topic) (rate(netflow_starrocks_records_committed_total{job=\"starrocks-writer\",topic=~\"$topic\"}[$__rate_interval]))", "legendFormat": "StarRocks committed {{topic}}", "refId": "G"},
        {"expr": "sum by (topic) (rate(netflow_starrocks_records_dlq_total{job=\"starrocks-writer\",topic=~\"$topic\"}[$__rate_interval]))", "legendFormat": "StarRocks DLQ {{topic}}", "refId": "I"}
      ],
      "fieldConfig": {"defaults": {"unit": "suffix: records/s", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "timeseries", "title": "Estimated Consumer Delay", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "(sum by (topic) (kafka_consumergroup_lag{consumergroup=\"netflow-hdfs-writer-group\",topic=~\"$topic\"}) / on (topic) sum by (topic) (rate(kafka_server_brokertopicmetrics_messagesin_total{job=\"kafka-broker\",topic=~\"$topic\"}[5m]))) and on (topic) (sum by (topic) (rate(kafka_server_brokertopicmetrics_messagesin_total{job=\"kafka-broker\",topic=~\"$topic\"}[5m])) > 0)", "legendFormat": "HDFS {{topic}}", "refId": "A"},
        {"expr": "(sum by (topic) (kafka_consumergroup_lag{consumergroup=\"netflow-starrocks-writer\",topic=~\"$topic\"}) / on (topic) sum by (topic) (rate(kafka_server_brokertopicmetrics_messagesin_total{job=\"kafka-broker\",topic=~\"$topic\"}[5m]))) and on (topic) (sum by (topic) (rate(kafka_server_brokertopicmetrics_messagesin_total{job=\"kafka-broker\",topic=~\"$topic\"}[5m])) > 0)", "legendFormat": "StarRocks {{topic}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "decimals": 0, "noValue": "No traffic"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "stat", "title": "Pipeline Totals in Selected Range", "gridPos": {"h": 5, "w": 16, "x": 0, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (topic) (increase(kafka_server_brokertopicmetrics_messagesin_total{job=\"kafka-broker\",topic=~\"$topic\"}[$__range])) or vector(0)", "legendFormat": "Kafka input {{topic}}", "instant": true, "refId": "A"},
        {"expr": "sum by (topic) (increase(netflow_hdfs_records_committed_total{job=\"hdfs-writer\",topic=~\"$topic\"}[$__range])) or vector(0)", "legendFormat": "HDFS committed {{topic}}", "instant": true, "refId": "B"},
        {"expr": "sum by (topic) (increase(netflow_hdfs_records_dlq_total{job=\"hdfs-writer\",topic=~\"$topic\"}[$__range])) or vector(0)", "legendFormat": "HDFS DLQ {{topic}}", "instant": true, "refId": "D"},
        {"expr": "sum by (topic) (increase(netflow_starrocks_records_committed_total{job=\"starrocks-writer\",topic=~\"$topic\"}[$__range])) or vector(0)", "legendFormat": "StarRocks committed {{topic}}", "instant": true, "refId": "C"},
        {"expr": "sum by (topic) (increase(netflow_starrocks_records_dlq_total{job=\"starrocks-writer\",topic=~\"$topic\"}[$__range])) or vector(0)", "legendFormat": "StarRocks DLQ {{topic}}", "instant": true, "refId": "E"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "decimals": 0}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "type": "timeseries", "title": "Retries and Errors", "gridPos": {"h": 5, "w": 8, "x": 16, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (topic) (rate(netflow_hdfs_operation_retries_total{job=\"hdfs-writer\",topic=~\"$topic\"}[$__rate_interval]))", "legendFormat": "HDFS retry {{topic}}", "refId": "A"},
        {"expr": "sum by (topic) (rate(netflow_hdfs_operation_errors_total{job=\"hdfs-writer\",topic=~\"$topic\"}[$__rate_interval]))", "legendFormat": "HDFS error {{topic}}", "refId": "B"},
        {"expr": "sum by (topic) (rate(netflow_starrocks_operation_retries_total{job=\"starrocks-writer\",topic=~\"$topic\"}[$__rate_interval]))", "legendFormat": "StarRocks retry {{topic}}", "refId": "C"},
        {"expr": "sum by (topic) (rate(netflow_starrocks_operation_errors_total{job=\"starrocks-writer\",topic=~\"$topic\"}[$__rate_interval]))", "legendFormat": "StarRocks error {{topic}}", "refId": "D"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "stat", "title": "Prometheus Scrape Target Availability", "gridPos": {"h": 5, "w": 18, "x": 0, "y": 18},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (job) (up) / count by (job) (up)", "legendFormat": "{{job}}", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}, "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "type": "stat", "title": "Prometheus Active Series", "gridPos": {"h": 5, "w": 6, "x": 18, "y": 18},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(prometheus_tsdb_head_series{job=\"prometheus\"})", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "decimals": 0}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    }
  ],
  "refresh": "10s", "schemaVersion": 41,
  "tags": ["netflow", "overview"],
  "templating": {"list": [{"name":"topic","label":"Topic","type":"query","datasource":{"type":"prometheus","uid":"prometheus"},"query":{"query":"label_values(kafka_topic_partition_current_offset{topic=~\"netflow|multi-version-netflow\"}, topic)","refId":"StandardVariableQuery"},"definition":"label_values(kafka_topic_partition_current_offset{topic=~\"netflow|multi-version-netflow\"}, topic)","refresh":1,"sort":1,"multi":true,"includeAll":true,"allValue":".*","current":{"selected":true,"text":"All","value":"$__all"}}]},
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "NetFlow Overview",
  "uid": "netflow-overview",
  "version": 5
}
