{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "links": [{"title": "Alerting", "type": "link", "url": "/alerting/list", "icon": "bell"}],
  "panels": [
    {
      "type": "stat", "title": "Requests in Selected Range", "gridPos": {"h": 4, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(increase(netflow_api_http_requests_total{job=\"rest-api\"}[$__range])) or vector(0)", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "decimals": 0}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "type": "stat", "title": "HTTP 4xx Ratio", "gridPos": {"h": 4, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "(sum(increase(netflow_api_http_requests_total{job=\"rest-api\",status_class=\"4xx\"}[$__range])) or vector(0)) / clamp_min((sum(increase(netflow_api_http_requests_total{job=\"rest-api\"}[$__range])) or vector(0)), 1)", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 0.01}, {"color": "red", "value": 0.05}]}, "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "type": "timeseries", "title": "HTTP Request Rate", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (route, status_class) (rate(netflow_api_http_requests_total{job=\"rest-api\"}[$__rate_interval]))", "legendFormat": "{{route}} · {{status_class}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "timeseries", "title": "HTTP P95 Duration", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(netflow_api_http_request_duration_seconds_bucket{job=\"rest-api\"}[$__rate_interval])))", "legendFormat": "{{route}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "timeseries", "title": "Database Query Rate", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (backend, outcome) (rate(netflow_api_queries_total{job=\"rest-api\"}[$__rate_interval])) or vector(0)", "legendFormat": "{{backend}} · {{outcome}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "timeseries", "title": "Database P95 Duration", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, backend, operation) (rate(netflow_api_query_duration_seconds_bucket{job=\"rest-api\"}[$__rate_interval]))) or vector(0)", "legendFormat": "{{backend}} · {{operation}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "stat", "title": "In-flight Requests", "gridPos": {"h": 5, "w": 12, "x": 0, "y": 20},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(netflow_api_http_requests_in_flight{job=\"rest-api\"}) or vector(0)", "legendFormat": "HTTP", "instant": true, "refId": "A"},
        {"expr": "sum(netflow_api_queries_in_flight{job=\"rest-api\"}) or vector(0)", "legendFormat": "Database", "instant": true, "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "min": 0}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "type": "stat", "title": "Query Errors in Selected Range", "gridPos": {"h": 5, "w": 12, "x": 12, "y": 20},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (backend, operation) (increase(netflow_api_queries_total{job=\"rest-api\",outcome=\"error\"}[$__range])) or vector(0)", "legendFormat": "{{backend}} · {{operation}}", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 1}]}, "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "type": "stat", "title": "External API Availability", "gridPos": {"h": 5, "w": 12, "x": 0, "y": 25},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "max(probe_success{job=\"rest-api-probe\"}) or vector(0)", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}, "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "type": "stat", "title": "External API Probe Duration", "gridPos": {"h": 5, "w": 12, "x": 12, "y": 25},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "max(probe_duration_seconds{job=\"rest-api-probe\"})", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    }
  ],
  "refresh": "10s", "schemaVersion": 41,
  "tags": ["netflow", "api"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "NetFlow REST API",
  "uid": "netflow-rest-api",
  "version": 6
}
