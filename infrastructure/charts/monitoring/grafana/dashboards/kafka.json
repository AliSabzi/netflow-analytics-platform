{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "links": [{"title": "Alerting", "type": "link", "url": "/alerting/list", "icon": "bell"}],
  "panels": [
    {
      "type": "stat", "title": "Under-replicated Partitions", "gridPos": {"h": 4, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(kafka_server_replicamanager_underreplicatedpartitions{job=\"kafka-broker\"}) or vector(0)", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 1}]}, "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "type": "stat", "title": "Offline Partitions", "gridPos": {"h": 4, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "max(kafka_controller_kafkacontroller_offlinepartitionscount{job=\"kafka-controller\"}) or vector(0)", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 1}]}, "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "type": "timeseries", "title": "Messages Received", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (topic) (rate(kafka_server_brokertopicmetrics_messagesin_total{job=\"kafka-broker\",topic=~\"$topic\"}[$__rate_interval]))", "legendFormat": "{{topic}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "suffix: messages/s", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "timeseries", "title": "Estimated Consumer Delay", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "(sum by (topic, consumergroup) (kafka_consumergroup_lag{topic=~\"$topic\"}) / on (topic) group_left sum by (topic) (rate(kafka_server_brokertopicmetrics_messagesin_total{job=\"kafka-broker\",topic=~\"$topic\"}[5m]))) and on (topic) (sum by (topic) (rate(kafka_server_brokertopicmetrics_messagesin_total{job=\"kafka-broker\",topic=~\"$topic\"}[5m])) > 0)", "legendFormat": "{{topic}} / {{consumergroup}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "decimals": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "timeseries", "title": "Broker Byte Rate", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (topic) (rate(kafka_server_brokertopicmetrics_bytesin_total{job=\"kafka-broker\",topic=~\"$topic\"}[$__rate_interval]))", "legendFormat": "Bytes in {{topic}}", "refId": "A"},
        {"expr": "sum by (topic) (rate(kafka_server_brokertopicmetrics_bytesout_total{job=\"kafka-broker\",topic=~\"$topic\"}[$__rate_interval]))", "legendFormat": "Bytes out {{topic}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "timeseries", "title": "Kafka Log Size", "description": "Kafka log bytes reported by JMX; this is not filesystem free space.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (instance, topic) (kafka_log_log_size{job=\"kafka-broker\",topic=~\"$topic\"})", "legendFormat": "{{topic}} / {{instance}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    }
  ],
  "refresh": "10s", "schemaVersion": 41,
  "tags": ["netflow", "kafka"],
  "templating": {"list": [{"name":"topic","label":"Topic","type":"query","datasource":{"type":"prometheus","uid":"prometheus"},"query":{"query":"label_values(kafka_topic_partition_current_offset{topic=~\"netflow|multi-version-netflow\"}, topic)","refId":"StandardVariableQuery"},"definition":"label_values(kafka_topic_partition_current_offset{topic=~\"netflow|multi-version-netflow\"}, topic)","refresh":1,"sort":1,"multi":true,"includeAll":true,"allValue":"netflow|multi-version-netflow","current":{"selected":true,"text":"All","value":"$__all"}}]},
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "Kafka",
  "uid": "netflow-kafka",
  "version": 7
}
