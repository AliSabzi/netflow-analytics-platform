<configuration>
    <property>
        <name>dfs.nameservices</name>
        <value>netflow-demo</value>
    </property>
    <property>
        <name>dfs.ha.namenodes.netflow-demo</name>
        <value>netflow-demo-node1,netflow-demo-node2,netflow-demo-node3</value>
    </property>
    <property>
        <name>dfs.namenode.rpc-address.netflow-demo.netflow-demo-node1</name>
        <value>netflow-demo-node1:8020</value>
    </property>
    <property>
        <name>dfs.namenode.http-address.netflow-demo.netflow-demo-node1</name>
        <value>netflow-demo-node1:9870</value>
    </property>
    <property>
        <name>dfs.namenode.rpc-bind-host.netflow-demo.netflow-demo-node1</name>
        <value>0.0.0.0</value>
    </property>
    <property>
        <name>dfs.namenode.http-bind-host.netflow-demo.netflow-demo-node1</name>
        <value>0.0.0.0</value>
    </property>
    <property>
        <name>dfs.namenode.rpc-address.netflow-demo.netflow-demo-node2</name>
        <value>netflow-demo-node2:8020</value>
    </property>
    <property>
        <name>dfs.namenode.http-address.netflow-demo.netflow-demo-node2</name>
        <value>netflow-demo-node2:9870</value>
    </property>
    <property>
        <name>dfs.namenode.rpc-bind-host.netflow-demo.netflow-demo-node2</name>
        <value>0.0.0.0</value>
    </property>
    <property>
        <name>dfs.namenode.http-bind-host.netflow-demo.netflow-demo-node2</name>
        <value>0.0.0.0</value>
    </property>
    <property>
        <name>dfs.namenode.rpc-address.netflow-demo.netflow-demo-node3</name>
        <value>netflow-demo-node3:8020</value>
    </property>
    <property>
        <name>dfs.namenode.http-address.netflow-demo.netflow-demo-node3</name>
        <value>netflow-demo-node3:9870</value>
    </property>
    <property>
        <name>dfs.namenode.rpc-bind-host.netflow-demo.netflow-demo-node3</name>
        <value>0.0.0.0</value>
    </property>
    <property>
        <name>dfs.namenode.http-bind-host.netflow-demo.netflow-demo-node3</name>
        <value>0.0.0.0</value>
    </property>
    <property>
        <name>dfs.namenode.shared.edits.dir</name>
        <value>qjournal://netflow-demo-node1:8485;netflow-demo-node2:8485;netflow-demo-node3:8485/netflow-demo</value>
    </property>
    <property>
        <name>dfs.client.failover.proxy.provider.netflow-demo</name>
        <value>org.apache.hadoop.hdfs.server.namenode.ha.ConfiguredFailoverProxyProvider</value>
    </property>
    <property>
        <name>dfs.replication</name>
        <value>1</value>
    </property>
    <property>
        <name>dfs.block.size</name>
        <value>134217728</value>
    </property>
    <property>
        <name>dfs.namenode.datanode.registration.ip-hostname-check</name>
        <value>false</value>
        <description>In clusters which use DNS, this should be set to false due to hadoop</description>
    </property>
    <property>
        <name>dfs.client.read.shortcircuit</name>
        <value>True</value>
    </property>
    <property>
        <name>dfs.domain.socket.path</name>
        <value>/var/lib/hadoop-hdfs/dn_socket</value>
    </property>
    <property>
        <name>dfs.namenode.support.allow.format</name>
        <value>True</value>
        <description>
            WARNING: This property is managed by Ansible.
            Enabling this allows NameNode formatting and MAY CAUSE IRREVERSIBLE DATA LOSS.
        </description>
    </property>

    <property>
        <name>dfs.ha.automatic-failover.enabled</name>
        <value>true</value>
    </property>
    <property>
        <name>dfs.ha.fencing.methods</name>
        <value>shell(/bin/true)</value>
    </property>
    <property>
        <name>dfs.ha.fencing.ssh.private-key-files</name>
        <value>/home/hadoop/.ssh/id_rsa</value>
    </property>
    <property>
        <name>dfs.ha.fencing.ssh.connect-timeout</name>
        <value>30000</value>
    </property>
    <property>
        <name>ha.zookeeper.quorum</name>
        <value>netflow-demo-node1:2181,netflow-demo-node2:2181,netflow-demo-node3:2181</value>
    </property>
    <property>
        <name>dfs.namenode.name.dir</name>
        <value>file:///mnt/disk1/namenode</value>
    </property>
    <property>
        <name>dfs.hosts</name>
        <value>/etc/namenode/dfs.include</value>
    </property>
    <property>
        <name>dfs.hosts.exclude</name>
        <value>/etc/namenode/dfs.exclude</value>
    </property>
    <property>
        <name>dfs.namenode.enable.retrycache</name>
        <value>True</value>
    </property>
    <property>
        <name>dfs.namenode.handler.count</name>
        <value>32</value>
    </property>
    <property>
        <name>dfs.namenode.stale.datanode.interval</name>
        <value>30000</value>
    </property>
    <property>
        <name>dfs.namenode.enable.log.stale.datanode</name>
        <value>True</value>
    </property>
    <property>
        <name>dfs.namenode.avoid.write.stale.datanode</name>
        <value>True</value>
    </property>
    <property>
        <name>dfs.namenode.avoid.read.stale.datanode</name>
        <value>True</value>
    </property>
    <property>
        <name>dfs.namenode.heartbeat.recheck-interval</name>
        <value>300000</value>
    </property>
    <property>
        <name>dfs.namenode.replication.min</name>
        <value>1</value>
    </property>

</configuration>
